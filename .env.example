APP_NAME=CRM KazUTB
APP_ENV=production
APP_DEBUG=false
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

AD_ENABLED=false
AD_HOST=dc1.kaztbu.edu.kz
AD_PORT=636
AD_USE_SSL=true
AD_TIMEOUT=5
AD_BIND_DN=api-kiosk@kaztbu.edu.kz
AD_BIND_PASSWORD=
AD_BASE_DN=ou=Univer,dc=kaztbu,dc=edu,dc=kz
AD_LOGIN_FIELD=samaccountname
AD_USER_FILTER='(&(objectClass=user)(objectCategory=person)(!(userAccountControl:1.2.840.113556.1.4.803:=2)))'
AD_REQUIRE_CERT=true

TOPIC_AI_ENABLED=false
TOPIC_AI_ENDPOINT=https://api.openai.com/v1/chat/completions
TOPIC_AI_MODEL=gpt-4o-mini
TOPIC_AI_API_KEY=
TOPIC_AI_TIMEOUT=15

# ИИ-помощник преподавателя: краткий пересказ документа и спорные места.
# Если TEACHER_AI_API_KEY пуст, используется OPENAI_API_KEY.
TEACHER_AI_ENABLED=false
TEACHER_AI_ENDPOINT=https://api.openai.com/v1/chat/completions
TEACHER_AI_MODEL=gpt-4o-mini
TEACHER_AI_API_KEY=
TEACHER_AI_TIMEOUT=90
TEACHER_AI_MAX_CHARS=60000
TEACHER_AI_DAILY_LIMIT=20
# Ассистент преподавателя: генерация лекций и презентаций (тот же ключ и адрес API).
# LESSON_MODEL пуст — используется TEACHER_AI_MODEL; CONCURRENCY — параллельных запросов за один запуск задания (1..8).
TEACHER_AI_LESSON_DAILY_LIMIT=10
TEACHER_AI_LESSON_TIMEOUT=90
TEACHER_AI_LESSON_MODEL=
TEACHER_AI_LESSON_CONCURRENCY=4
# Иллюстрации к слайдам (OpenAI Images, тот же ключ): модель, качество (low|medium|high), максимум картинок на презентацию.
TEACHER_AI_IMAGES_ENABLED=true
TEACHER_AI_IMAGE_MODEL=gpt-image-1.5
TEACHER_AI_IMAGE_QUALITY=low
TEACHER_AI_IMAGES_MAX=8
TEACHER_AI_IMAGE_CONCURRENCY=3

TELESCOPE_ENABLED=false
PULSE_ENABLED=false

# Swagger UI must stay disabled in production.
L5_SWAGGER_GENERATE_ALWAYS=false

# Frontend env vars
VITE_APP_NAME="${APP_NAME}"
VITE_HOME_URL=http://10.0.1.47/
VITE_LIBRARY_URL=http://10.0.1.8/
# Comma-separated emails allowed to manage Templates (besides admins)
TEMPLATES_ALLOWED_EMAILS=
