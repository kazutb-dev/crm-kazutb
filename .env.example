APP_NAME=CRM KazUTB
APP_ENV=local
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

AD_ENABLED=false
AD_HOST=dc1.kaztbu.edu.kz
AD_PORT=636
AD_USE_SSL=true
AD_TIMEOUT=5
AD_BIND_DN=api-kiosk@kaztbu.edu.kz
AD_BIND_PASSWORD=
AD_BASE_DN=ou=Univer,dc=kaztbu,dc=edu,dc=kz
AD_LOGIN_FIELD=samaccountname
AD_USER_FILTER='(&(objectClass=user)(objectCategory=person)(!(userAccountControl:1.2.840.113556.1.4.803:=2)))'
AD_REQUIRE_CERT=true

TOPIC_AI_ENABLED=false
TOPIC_AI_ENDPOINT=https://api.openai.com/v1/chat/completions
TOPIC_AI_MODEL=gpt-4o-mini
TOPIC_AI_API_KEY=
TOPIC_AI_TIMEOUT=15
